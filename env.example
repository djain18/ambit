# Ambit — environment template
#
# Copy this file to `.env` in the same folder and fill in real values there.
# `.env` is gitignored. This file is committed and must NEVER contain a real
# key — placeholders only.
#
#   Windows:  copy env.example .env
#   Unix:     cp env.example .env
#
# Razorpay Dashboard → Settings → API Keys, with the mode toggle set to TEST.
# Test keys always start with `rzp_test_`. If yours starts with `rzp_live_`,
# stop — that is the live key and must not be used here.

# ── Razorpay (TEST MODE ONLY) ────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Set when you create a webhook in the Dashboard (Milestone 0).
# Used to verify the X-Razorpay-Signature header on incoming webhooks.
RAZORPAY_WEBHOOK_SECRET=

# Safety rail: the app refuses to start if this is true and the key id does
# not begin with rzp_test_. Leave it on.
AMBIT_REQUIRE_TEST_MODE=true

# ── Ambit ────────────────────────────────────────────────────────────────
AMBIT_HOST=127.0.0.1
AMBIT_PORT=8000

# Public URL your webhook tunnel exposes (ngrok / cloudflared), e.g.
# https://something.ngrok-free.app — set during Milestone 0.
AMBIT_PUBLIC_URL=

# Ed25519 signing key for grants, generated locally. Lives in keys/,
# which is gitignored.
AMBIT_GRANT_SIGNING_KEY_PATH=keys/grant_signing_key.pem

# ── Buyer agent (the only LLM in the project, and it sits outside the
#    money-decision path — see docs/ARCHITECTURE.md) ─────────────────────
ANTHROPIC_API_KEY=
